# Andor environment variables
# Copy this file to .env.local for local development.
# Never commit .env.local or real credentials.

# Use the local origin in development; override it with the canonical HTTPS
# origin in production. OAuth redirects are derived from this value.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
# Long random server-only value used to bind group invitations to an email.
ANDOR_EMAIL_HASH_SECRET=replace-with-at-least-32-random-bytes
GOOGLE_GENERATIVE_AI_API_KEY=AIza...
ANDOR_GOOGLE_MODEL=gemini-3.6-flash

# Optional AI providers
GROQ_API_KEY=gsk_...
ANTHROPIC_API_KEY=sk-ant-...
ANDOR_GROQ_MODEL=openai/gpt-oss-120b
ANDOR_ANTHROPIC_MODEL=claude-sonnet-5
ACTIVE_LOCALE=pt

# Optional booking/search provider adapters
# URL templates may use {origin}, {destination}, {city}, {country},
# {startDate}, {endDate}, and {travelers}. Empty values use public search links.
FLIGHTS_PROVIDER_SEARCH_URL=
HOTELS_PROVIDER_SEARCH_URL=
RENTAL_CARS_PROVIDER_SEARCH_URL=
PLACES_PROVIDER_SEARCH_URL=
PDF_EXPORT_PROVIDER=browser_pdf

# Optional enrichment providers
# Missing credentials disable the corresponding enrichment. They must not trigger
# synthetic ratings, prices, opening hours, or availability.
OPENTRIPMAP_API_KEY=
FOURSQUARE_API_KEY=
AMADEUS_API_KEY=
AMADEUS_API_SECRET=
AMADEUS_API_BASE_URL=https://test.api.amadeus.com

# Supabase setup
# Run supabase/schema.sql before deploying.
# NEXT_PUBLIC_* values are bundled for the browser and must never be secrets.
# SUPABASE_SECRET_KEY and all provider API keys are server-only.
# Legacy key names remain supported: NEXT_PUBLIC_SUPABASE_ANON_KEY and
# SUPABASE_SERVICE_ROLE_KEY. Never expose a secret/service-role key to the browser.
# Local development falls back to the path below when Supabase is not configured.
# Production must use durable Supabase/Postgres or an explicitly persistent
# self-hosted SQLite volume; browser storage is never authoritative.
ANDOR_SQLITE_PATH=.andor/andor.sqlite
